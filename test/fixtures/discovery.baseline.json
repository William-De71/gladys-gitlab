            "type": "string"
          },
          {
            "key": "author",
            "type": "string"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "star_added",
        "fields": [
          {
            "key": "repository",
            "options": []
          }
