{
  "version": "0.1.0",
  "devices": {
    "repository": {
      "external_id": "ext:gitlab:repository:101",
      "should_poll": false,
      "params": ["GITLAB_PROJECT"],
      "features": [
        {
          "external_id": "ext:gitlab:repository:101:stars",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:forks",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:open_issues",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:open_merge_requests",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:merged_merge_requests",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:latest_release",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:latest_tag",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:latest_commit",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:latest_issue",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:latest_merge_request",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:repository:101:pipeline",
          "category": "text",
          "type": "text",
          "min": 0,
          "max": 0,
          "read_only": true,
          "has_feedback": false
        }
      ]
    },
    "account": {
      "external_id": "ext:gitlab:account:7",
      "should_poll": false,
      "params": ["GITLAB_USERNAME"],
      "features": [
        {
          "external_id": "ext:gitlab:account:7:followers",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:account:7:following",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        },
        {
          "external_id": "ext:gitlab:account:7:projects",
          "category": "counter-sensor",
          "type": "integer",
          "min": 0,
          "max": 100000000,
          "read_only": true,
          "has_feedback": false
        }
      ]
    }
  },
  "manifest": {
    "config_schema": [
      {
        "key": "intro",
        "type": "section"
      },
      {
        "key": "url",
        "type": "string"
      },
      {
        "key": "token",
        "type": "secret"
      },
      {
        "key": "repositories_intro",
        "type": "section"
      },
      {
        "key": "repositories",
        "type": "string"
      },
      {
        "key": "poll_interval",
        "type": "number"
      },
      {
        "key": "language",
        "type": "select"
      }
    ],
    "scene_triggers": [
