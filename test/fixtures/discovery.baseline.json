        "variables": [
          {
            "key": "repository_name",
            "type": "string"
          },
          {
            "key": "stars",
            "type": "number"
          },
          {
            "key": "added",
            "type": "number"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "pipeline_completed",
