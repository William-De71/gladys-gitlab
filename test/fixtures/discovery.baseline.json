    "scene_actions": [
      {
        "key": "get_repository",
        "fields": ["repository"],
        "outputs": [
          {
            "key": "repository_name",
            "type": "string"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "stars",
            "type": "number"
          },
          {
