          {
            "key": "state",
            "options": ["success", "failed", "canceled"]
          }
        ],
        "variables": [
          {
            "key": "repository_name",
            "type": "string"
          },
          {
            "key": "state",
            "type": "string"
          },
          {
            "key": "branch",
            "type": "string"
          },
          {
            "key": "sha",
            "type": "string"
          },
          {
            "key": "message",
            "type": "string"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      }
