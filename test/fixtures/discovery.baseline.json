          },
          {
            "key": "author",
            "type": "string"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "issue_opened",
        "fields": [
          {
            "key": "repository",
            "options": []
          }
        ],
        "variables": [
          {
            "key": "repository_name",
            "type": "string"
          },
          {
            "key": "number",
            "type": "number"
          },
          {
            "key": "title",
            "type": "string"
          },
          {
            "key": "author",
            "type": "string"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "merge_request_opened",
        "fields": [
          {
            "key": "repository",
            "options": []
          }
        ],
        "variables": [
          {
            "key": "repository_name",
            "type": "string"
          },
          {
            "key": "number",
            "type": "number"
          },
          {
            "key": "title",
            "type": "string"
          },
          {
            "key": "author",
            "type": "string"
          },
          {
            "key": "draft",
            "type": "boolean"
          },
          {
            "key": "url",
            "type": "string"
          },
          {
            "key": "summary",
            "type": "string"
          }
        ]
      },
      {
        "key": "commit_pushed",
        "fields": [
          {
            "key": "repository",
            "options": []
          }
